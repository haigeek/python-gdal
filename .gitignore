# 环境与缓存（体积大，不入库；不带尾斜杠以同时忽略 .conda 符号链接）
.conda
.mamba
.home
.cache
.tools
.miniconda/
.conda-pkgs/

# 本地验证库数据目录
pgdata/

# Web 上传目录（zip 解压后的 GDB）
uploads/

# 前端构建产物（Vite build 输出到 gdb2pg/web/static）
gdb2pg/web/static/

# Node
frontend/node_modules/
frontend/dist/
frontend/.npm-cache/

# Python
__pycache__/
*.pyc
.venv/
.pip-cache/

# macOS
.DS_Store

# 本地密钥（VSCode 调试环境变量，勿入库）
.env

# 业务库连接等真实配置（含密码，勿入库；模板见 configs/web.json.example）
configs/web.json

# 真实配置（本机路径 / 内网地址等，勿入库；保留 .example / 模板文件）
configs/web.dev.json
configs/dev_local.json