{
  "shp": "/path/to/roads.shp",
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "dbname": "postgres",
    "user": "postgres",
    "password_env": "GDB2PG_PGPASSWORD",
    "schema": "public",
    "ssl": "prefer",
    "ensure_postgis": false
  },
  "default": {
    "srid": 4326,
    "mode": "create",
    "geometries": true,
    "create_spatial_index": true,
    "launder_columns": false,
    "launder_tables": true,
    "pk_field": "",
    "geom_column": "shape",
    "on_error": "abort"
  },
  "selectors": {
    "include": ["*"],
    "exclude": []
  },
  "layers": []
}
