{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev_web：起本地库并启动 Web",
      "type": "shell",
      "command": "bash scripts/dev_web.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "前端构建（npm run build）",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": { "npm_config_cache": "${workspaceFolder}/frontend/.npm-cache" } },
      "problemMatcher": ["$tsc"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "前端开发服务器（npm run dev）",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend", "env": { "npm_config_cache": "${workspaceFolder}/frontend/.npm-cache" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}